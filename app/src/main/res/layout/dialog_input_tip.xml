<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Чтобы на виртуальном столе работала мышка или джойстик, после подключения VR-гарнитуры заблокируйте и сразу разблокируйте телефон."
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:lineSpacingExtra="2dp" />

    <CheckBox
        android:id="@+id/dontShowAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Больше не показывать"
        android:textSize="13sp" />
</LinearLayout>
